# Development Environment Configuration for AWS Deployment
# ================================================================

# PostgreSQL Configuration (AWS RDS)
# Replace these values with your actual RDS instance details
PG_HOST=your-rds-endpoint.region.rds.amazonaws.com
PG_PORT=5432
PG_PASS=your-secure-rds-password
PG_USER=authentik
PG_DB=authentik_dev

# Redis Configuration (Container-based for dev simplicity)
REDIS_HOST=redis

# Domain & SSL Configuration
AUTHENTIK_COOKIE_DOMAIN=dev-auth.testimonialtree.com
AUTHENTIK_CSRF_COOKIE_SECURE=true
AUTHENTIK_SESSION_COOKIE_SECURE=true

# authentik Configuration
AUTHENTIK_SECRET_KEY=dev-change-this-to-a-secure-random-key-64-characters-long-minimum
AUTHENTIK_ERROR_REPORTING__ENABLED=false
AUTHENTIK_LOG_LEVEL=debug

# Database connection for authentik
AUTHENTIK_POSTGRESQL__HOST=${PG_HOST}
AUTHENTIK_POSTGRESQL__PORT=${PG_PORT}
AUTHENTIK_POSTGRESQL__NAME=${PG_DB}
AUTHENTIK_POSTGRESQL__PASSWORD=${PG_PASS}
AUTHENTIK_POSTGRESQL__USER=${PG_USER}

# Redis connection
AUTHENTIK_REDIS__HOST=${REDIS_HOST}

# Email Configuration (using console backend for development)
AUTHENTIK_EMAIL__HOST=localhost
AUTHENTIK_EMAIL__PORT=25
AUTHENTIK_EMAIL__FROM=authentik@testimonialtree.com

# Development settings
DEBUG=false
AUTHENTIK_WEB__DISABLE_X_FRAME_OPTIONS=true

# Port Configuration
COMPOSE_PORT_HTTP=9000
COMPOSE_PORT_HTTPS=9443

# AWS Specific Settings (if using S3 for media storage)
# AWS_ACCESS_KEY_ID=your-access-key
# AWS_SECRET_ACCESS_KEY=your-secret-key
# AWS_STORAGE_BUCKET_NAME=authentik-dev-media
# AWS_S3_REGION_NAME=us-west-2

# Docker image configuration
AUTHENTIK_TAG=2024.8.3